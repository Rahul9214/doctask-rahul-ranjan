# Local development defaults only. Replace before any non-local use.
# Compose password contract: use ASCII letters, digits, and underscores only ([A-Za-z0-9_]+).
# The same literal value is used by PostgreSQL and interpolated into DATABASE_URL; percent-encoded
# or other special-character passwords are not supported by this simple local Compose path.
#
# REQUIRED for Compose and host-side application/test databases.
POSTGRES_DB=project_assurance
POSTGRES_USER=project_assurance
POSTGRES_PASSWORD=local_only
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# APPLICATION IDENTITY. Compose supplies these release values; host processes may override them.
APP_NAME=Project Assurance Register
APP_VERSION=1.0.0
CURRENT_PHASE=Phase 10 — Final Delivery

# REQUIRED for host-side backend commands (Compose injects its own container-internal URL).
DATABASE_URL=postgresql+asyncpg://project_assurance:local_only@localhost:5432/project_assurance

# REQUIRED for integration tests. Must name project_assurance_test and differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql+asyncpg://project_assurance:local_only@localhost:5432/project_assurance_test
ALLOW_DESTRUCTIVE_TEST_DATABASE=false

# OPTIONAL local development.
MAX_UPLOAD_BYTES=10485760
READINESS_TIMEOUT_SECONDS=3
SOURCE_STORAGE_PATH=var/source-files
WATCH_INPUT_PATH=var/watch-inbox
WATCH_POLL_SECONDS=2
WATCH_STABLE_POLLS=2
# RULESET_PATH=backend/src/app/rulesets/software-project-assurance.v1.json

# LOCAL DEVELOPMENT / LIVE MODEL OPTIONAL. Default MODEL_PROVIDER=deterministic requires no key.
MODEL_PROVIDER=deterministic
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=2
# OPENAI_API_KEY is required only when MODEL_PROVIDER=openai. Do not commit it.
